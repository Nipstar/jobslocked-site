# jobslocked.com — Apache config (Plesk default nginx-proxy-to-Apache setup).
# If Plesk hosting is set to "serve static files directly by nginx", mirror the
# headers below in Plesk > Apache & nginx Settings > Additional nginx directives.

ErrorDocument 404 /404.html

# --- security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "payment=(self \"https://crm.antekautomation.com\")"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://crm.antekautomation.com https://widgets.leadconnectorhq.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com; img-src 'self' data: https://crm.antekautomation.com https://*.leadconnectorhq.com https://*.msgsndr.com; frame-src https://crm.antekautomation.com https://*.leadconnectorhq.com; connect-src 'self' https://crm.antekautomation.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com; font-src 'self' data: https://*.leadconnectorhq.com; media-src 'self' https://*.leadconnectorhq.com https://*.msgsndr.com; base-uri 'self'; form-action 'self' https://crm.antekautomation.com https://*.leadconnectorhq.com"
</IfModule>

# --- caching: long for static assets, short for HTML ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- llms.txt served as plain text ---
<Files "llms.txt">
  ForceType 'text/plain; charset=utf-8'
</Files>
<Files "llms-full.txt">
  ForceType 'text/plain; charset=utf-8'
</Files>

# --- keep repo housekeeping files off the web ---
RedirectMatch 404 ^/reference(/|$)
RedirectMatch 404 ^/qa(/|$)
RedirectMatch 404 ^/README\.md$
RedirectMatch 404 ^/\.git
